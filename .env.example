# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or self-hosted).
# Use the *pooled* connection string on serverless hosts.
DATABASE_URL=postgres://bfc:bfc@localhost:5432/bfc

# Direct (non-pooled) connection string, used only for migrations and admin scripts.
# Neon's Vercel integration sets it automatically. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Optional: a second connection string for a restricted database role that can
# only SELECT from the `public_events` view. When set, every public page, API
# and feed uses it, so private rows are unreachable even if app code is wrong.
# Create the role with `npm run db:public-role` (see docs/SECURITY.md).
# DATABASE_URL_PUBLIC=

# Public origin of the deployment, used to build subscription URLs.
APP_URL=http://localhost:3000

# First Super Admin, created by `npm run db:seed` if no user exists yet.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please-12
SEED_ADMIN_NAME=BFC Admin

# Secret used to authorise the scheduled-publication cron endpoint (/api/cron/publish).
CRON_SECRET=

# Optional: when set, the first-run page (/setup) asks for this code before creating
# the first Super Admin, so nobody else can claim a freshly deployed site.
# SETUP_TOKEN=
